# Copiar a .env (en la raíz del repo) y ajustar si hace falta.
# Valores SOLO para desarrollo local.

NODE_ENV=development

# La web (Vite, HTTPS) se sirve en WEB_PORT y redirige /api a la API.
WEB_PORT=8050
API_PORT=3050

# PostgreSQL + PostGIS levantado con `npm run db:up` (docker-compose.yml).
DATABASE_URL=postgres://ascensores:ascensores_dev@localhost:5433/ascensores

# Orígenes autorizados por CORS, separados por coma. Sólo se aplican fuera de producción.
# Es el origen de Scrum Master AI, desde donde se corren los Tests de "Verificación en vivo".
# Nunca "*".
CORS_ORIGINS=https://scrum.nuestrocamino.cloud
