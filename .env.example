# Copiar a .env (en la raíz del repo) y ajustar si hace falta.
# Valores SOLO para desarrollo local.

NODE_ENV=development

# La web (Vite, HTTPS) se sirve en WEB_PORT y redirige /api a la API.
WEB_PORT=8050
API_PORT=3050

# PostgreSQL + PostGIS levantado con `npm run db:up` (docker-compose.yml).
DATABASE_URL=postgres://ascensores:ascensores_dev@localhost:5433/ascensores

# Orígenes autorizados por CORS, separados por coma. Sólo se aplican fuera de producción.
# Es el origen de Scrum Master AI, desde donde se corren los Tests de "Verificación en vivo".
# Nunca "*".
CORS_ORIGINS=https://scrum.nuestrocamino.cloud

# Autenticación (HU-14).
# Secreto con que se firman los tokens de acceso: al menos 32 caracteres.
# Generar uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Si queda vacío, la API genera uno al azar en cada arranque (las sesiones no sobreviven a un reinicio).
AUTH_JWT_SECRET=

# Primer Administrador: se crea al arrancar sólo si todavía no hay ninguno.
# Valores SOLO para desarrollo: en cualquier otro entorno, una contraseña propia.
ADMIN_INICIAL_USUARIO=admin
ADMIN_INICIAL_PASSWORD=Admin-Desarrollo-2026
