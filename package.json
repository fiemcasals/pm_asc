{
  "name": "mant-asc",
  "private": true,
  "description": "Sistema de inspecciones de ascensores (CABA): PWA para el RT en calle, portal web y API.",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "certs": "node scripts/certs.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces",
    "test:int": "npm run test:int -w apps/api",
    "verify": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
